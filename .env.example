# Copy to .env and fill in. Never commit .env.
#
# Read only by the classify layer. The scanner and catalog never touch this.

SIFT_PROVIDER=google_genai
SIFT_MODEL=gemini-3.1-flash-lite

# A backstop against a runaway agent loop. One question spends 3-6 requests.
# On a free Gemini key drop this to 12 — the free tier allows only 15 a minute.
SIFT_REQUESTS_PER_MINUTE=300

# Switching provider also needs its LangChain package installed:
#   anthropic -> langchain-anthropic     openai -> langchain-openai
#
# Set the key for whichever provider you selected above; leave the rest unset.
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

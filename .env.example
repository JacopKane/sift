# Copy to .env and fill in. Never commit .env.
#
# Read only by the classify layer. The scanner and catalog never touch this.

SIFT_PROVIDER=google_genai
SIFT_MODEL=gemini-3.1-flash-lite

# Set the key for whichever provider you selected above; leave the rest unset.
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
